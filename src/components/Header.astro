---
import { shopInfo } from '../data/services';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <span class="brand-mark brand-logo"><img src="/images/logo.jpg" alt="O3 汽車美容 SPA 館 logo" /></span>
      <span class="brand-text">
        <strong>O3 汽車美容</strong>
        <span>高鐵店 · 台中烏日</span>
      </span>
    </a>

    <nav>
      <ul class="nav-links">
        <li><a href="/" class={isActive('/') ? 'active' : ''}>首頁</a></li>
        <li><a href="/#about">公司簡介</a></li>
        <li><a href="/services/" class={isActive('/services') ? 'active' : ''}>服務項目</a></li>
        <li><a href="/news/" class={isActive('/news') ? 'active' : ''}>最新消息</a></li>
        <li><a href="/#contact">聯絡我們</a></li>
        <li>
          <a class="btn btn-gold nav-cta" href={shopInfo.phoneHref} style="padding: 11px 26px; font-size: 14px;">
            立即預約
          </a>
        </li>
      </ul>
    </nav>

    <button class="nav-toggle" aria-label="開啟選單">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
