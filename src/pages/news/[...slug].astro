---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { shopInfo } from '../../data/services';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (d: Date) =>
  d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`${post.data.title}｜O3 汽車美容 高鐵店`} description={post.data.description}>
  <article class="article">
    <header class="article-hero">
      <div class="container">
        <a class="article-back" href="/news/">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          返回最新消息
        </a>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <h1>{post.data.title}</h1>
        <p class="article-desc">{post.data.description}</p>
      </div>
    </header>

    {post.data.image && (
      <div class="container">
        <div class="article-cover">
          <img src={post.data.image} alt={post.data.title} />
        </div>
      </div>
    )}

    <div class="container">
      <div class="article-body prose">
        <Content />
      </div>

      <div class="cta-band reveal" style="margin: 60px 0 90px;">
        <div>
          <span class="eyebrow" style="margin-bottom: 14px;">Booking</span>
          <h2>想讓愛車<span class="gold-text">煥然一新？</span></h2>
          <p>歡迎來電預約，搭高鐵前交車、回程取車，時間剛剛好。</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-gold" href={shopInfo.phoneHref}>來電預約 {shopInfo.phone}</a>
          <a class="btn btn-ghost" href="/services/">查看服務價目</a>
        </div>
      </div>
    </div>
  </article>
</Base>
